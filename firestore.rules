rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠ এখানে তোমার admin ইমেইল দাও (config.js এর সাথে একই)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['csm.mohasin@gmail.com'];
    }

    match /settings/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /files/{id} {
      allow read: if true;
      allow write: if isAdmin();

      // ডাউনলোড লিংক: শুধু admin বা approved ক্রেতা
      match /secret/{s} {
        allow read: if isAdmin() || (request.auth != null
          && get(/databases/$(database)/documents/orders/$(request.auth.uid + '_' + id)).data.status == 'approved'
          && get(/databases/$(database)/documents/orders/$(request.auth.uid + '_' + id)).data.get('downloaded', false) != true);
        allow write: if isAdmin();
      }
    }

    match /orders/{oid} {
      allow get: if isAdmin() || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && oid == request.auth.uid + '_' + request.resource.data.fileId
        && request.resource.data.status == 'pending';

      // ইউজার শুধু rejected অর্ডার আবার pending করতে পারবে
      allow update: if isAdmin() || (request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'rejected'
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == resource.data.uid)
        || (request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'approved'
        && resource.data.get('downloaded', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloaded'])
        && request.resource.data.downloaded == true);

      allow delete: if isAdmin();
    }

    // push notification token
    match /tokens/{uid} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
